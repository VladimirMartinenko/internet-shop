# Public Company ID from Klaviyo (Settings → API keys). Never put the private key here.
# REACT_APP_KLAVIYO_PUBLIC_KEY=

# Optional overrides. If unset:
#   npm start  -> http://localhost:5000/api/ and /images/
#   npm run build (prod) -> /api/ and /images/ (same host via nginx)
#
# REACT_APP_API_URL=http://localhost:5000/api/
# REACT_APP_IMAGES_URL=http://localhost:5000/images/
