PORT=5000
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=internet_shop_db

# local Node: localhost
# docker compose dev: db-dev
# docker compose prod: db-prod
DB_HOST=localhost

# Private key from Klaviyo (Settings → API keys). Never expose to the client.
# KLAVIYO_PRIVATE_API_KEY=
# KLAVIYO_REVISION=2026-01-15
# Audience list ID from Klaviyo (Audience → Lists). Used only when the checkout checkbox is checked.
# KLAVIYO_LIST_ID=
# STORE_BASE_URL=http://localhost:3000
# STORE_IMAGES_URL=http://localhost:5000/images/
